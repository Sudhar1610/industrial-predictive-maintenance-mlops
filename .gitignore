# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/

# Env / secrets
.env
*.pem

# Data: data/raw is DVC-tracked (see data/raw.dvc + data/.gitignore,
# both DVC-managed). data/processed is transient, regenerated by the
# pipeline, and not tracked by either git or DVC.
data/processed/*
!data/processed/.gitkeep

# MLflow / registry
mlflow/
artifacts/
mlruns/

# DVC cache and local remote storage (regenerate via `dvc pull`/`dvc push`
# against the configured local remote; never git-tracked)
.dvc/cache
.dvc/tmp
dvc-storage/

# Testing / coverage
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# Conda-pack bundle output
bundle/
*.tar.gz

# IDE / OS
.vscode/
.idea/
.DS_Store

# Logs
logs/
*.log
