# Copy to .env and fill in for Stage 2/3. Stage 1 (csv datasource,
# console alerting) needs none of these -- CSV/console are hardcoded to
# not require credentials, so `configs/*.yaml` resolves fine with this
# file absent entirely.

# --- SQL datasource (Stage 2/3, when datasource_config.yaml active_source: sql) ---
SQL_HOST=
SQL_DB=
SQL_USER=
SQL_PASSWORD=

# --- MongoDB datasource (Stage 2/3, when datasource_config.yaml active_source: mongodb) ---
MONGO_URI=

# --- MS Teams alerting (Stage 2/3, when alerting_config.yaml active_channel: teams_webhook) ---
TEAMS_WEBHOOK_URL=
